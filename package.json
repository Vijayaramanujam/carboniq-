{
  "name": "carboniq-root",
  "version": "1.0.0",
  "description": "CarbonIQ - Intelligent Enterprise Carbon Accounting Engine for Indian SMEs",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm --prefix client install && npm --prefix client run build",
    "install:all": "npm --prefix server install && npm --prefix client install",
    "seed": "npm --prefix server run seed:all",
    "test": "npm --prefix server test",
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "client": "npm --prefix client dev",
    "build:client": "npm --prefix client run build"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "axios": "^1.21.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "form-data": "^4.0.6",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "sharp": "^0.35.5",
    "xlsx": "^0.18.5"
  }
}
